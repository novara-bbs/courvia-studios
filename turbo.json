{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "PAYLOAD_SECRET",
    "NEXT_PHASE",
    "SUPABASE_URL",
    "SUPABASE_PUBLISHABLE_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "NODE_ENV",
        "NEXT_PUBLIC_*",
        "VERCEL_ENV",
        "VERCEL",
        "CI"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "@courvia/commerce-domain#test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/payments-*/**"
      ]
    },
    "@courvia/design-tokens#test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/ui/src/**/*.css",
        "$TURBO_ROOT$/packages/sections/src/**/*.css",
        "$TURBO_ROOT$/apps/web/app/**/*.css"
      ]
    },
    "@courvia/web#test": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    }
  }
}
