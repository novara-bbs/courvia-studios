{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "PAYLOAD_SECRET",
    "NEXT_PHASE",
    "SUPABASE_URL",
    "SUPABASE_PUBLISHABLE_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "NODE_ENV",
        "NEXT_PUBLIC_*",
        "VERCEL_ENV",
        "VERCEL",
        "CI"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "@courvia/commerce-domain#test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/payments-*/**"
      ]
    },
    "@courvia/design-tokens#test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/ui/src/**/*.css",
        "$TURBO_ROOT$/packages/sections/src/**/*.css",
        "$TURBO_ROOT$/apps/web/app/**/*.css"
      ]
    },
    "@courvia/web#test": {
      "dependsOn": [
        "^build",
        "build"
      ],
      "cache": false
    },
    // typecheck y lint de la app LEEN `.next/types`, que lo escribe su propio
    // build. Mientras corrían en paralelo, `pnpm verify` fallaba a veces con
    // `Cannot find module './routes.js'`: el validador ya escrito y las rutas
    // todavía no. Medido dos veces el 22 ago 2026. Depender del build propio
    // cuesta esperar a un camino crítico que ya lo era, y a cambio los tipos
    // que se validan son los de ESTE build y no los del anterior.
    "@courvia/web#typecheck": {
      "dependsOn": [
        "^build",
        "build"
      ]
    },
    "@courvia/web#lint": {
      "dependsOn": [
        "^build",
        "build"
      ]
    }
  }
}
