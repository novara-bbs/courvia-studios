{
  "name": "@courvia/config",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Shared tsconfig and eslint configuration for the Courvia monorepo",
  "exports": {
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./tsconfig.react.json": "./tsconfig.react.json",
    "./eslint": "./eslint.config.mjs",
    "./stylelint": "./stylelint.config.mjs"
  },
  "dependencies": {
    "@next/eslint-plugin-next": "16.3.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript-eslint": "8.67.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "vitest": "4.1.11",
    "typescript": "5.9.3",
    "@types/node": "22.20.1"
  }
}
