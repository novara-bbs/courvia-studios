{
  "$description": "Courvia Design Tokens · W3C Design Tokens Community Group format · compatible con Style Dictionary, Tokens Studio y Figma Variables. Estructura: primitivos globales + 3 temas semánticos (volt-precision, carbon-drive, club-real).",
  "global": {
    "space": {
      "1": { "$type": "dimension", "$value": "4px" },
      "2": { "$type": "dimension", "$value": "8px" },
      "3": { "$type": "dimension", "$value": "12px" },
      "4": { "$type": "dimension", "$value": "16px" },
      "6": { "$type": "dimension", "$value": "24px" },
      "8": { "$type": "dimension", "$value": "32px" },
      "12": { "$type": "dimension", "$value": "48px" },
      "16": { "$type": "dimension", "$value": "64px" },
      "24": { "$type": "dimension", "$value": "96px" }
    },
    "radius": {
      "sm": { "$type": "dimension", "$value": "6px" },
      "md": { "$type": "dimension", "$value": "12px" },
      "lg": { "$type": "dimension", "$value": "20px" },
      "pill": { "$type": "dimension", "$value": "999px" }
    },
    "font": {
      "size": {
        "xs": { "$type": "dimension", "$value": "12px" },
        "sm": { "$type": "dimension", "$value": "14px" },
        "md": { "$type": "dimension", "$value": "16px" },
        "lg": { "$type": "dimension", "$value": "20px" },
        "xl": { "$type": "dimension", "$value": "28px" },
        "2xl": { "$type": "dimension", "$value": "40px" },
        "display": { "$type": "dimension", "$value": "clamp(44px, 8vw, 104px)" }
      },
      "lineHeight": {
        "tight": { "$type": "number", "$value": 1.0 },
        "snug": { "$type": "number", "$value": 1.25 },
        "body": { "$type": "number", "$value": 1.6 }
      }
    },
    "breakpoint": {
      "sm": { "$type": "dimension", "$value": "480px" },
      "md": { "$type": "dimension", "$value": "680px" },
      "lg": { "$type": "dimension", "$value": "860px" },
      "xl": { "$type": "dimension", "$value": "1180px" }
    },
    "focus": {
      "width": { "$type": "dimension", "$value": "2px" },
      "offset": { "$type": "dimension", "$value": "3px" }
    },
    "elevation": {
      "raised": { "$type": "shadow", "$value": { "color": "#0C132226", "offsetX": "0px", "offsetY": "6px", "blur": "20px", "spread": "0px" } }
    },
    "motion": {
      "duration": {
        "fast": { "$type": "duration", "$value": "150ms" },
        "base": { "$type": "duration", "$value": "300ms" },
        "slow": { "$type": "duration", "$value": "600ms" }
      },
      "easing": {
        "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] }
      }
    },
    "color": {
      "court": {
        "950": { "$type": "color", "$value": "#081426" },
        "700": { "$type": "color", "$value": "#123C7A" },
        "500": { "$type": "color", "$value": "#3E6ED8" }
      },
      "volt": {
        "400": { "$type": "color", "$value": "#D8F343" }
      },
      "line": {
        "50": { "$type": "color", "$value": "#F4F7F2" }
      },
      "carbon": {
        "900": { "$type": "color", "$value": "#1B1D20" },
        "700": { "$type": "color", "$value": "#33373C" }
      },
      "alloy": {
        "300": { "$type": "color", "$value": "#C7CCD1" },
        "100": { "$type": "color", "$value": "#E8E7E3" }
      },
      "drive": {
        "500": { "$type": "color", "$value": "#FF5A1F" },
        "600": { "$type": "color", "$value": "#E24E12" }
      },
      "pine": {
        "800": { "$type": "color", "$value": "#14503C" },
        "600": { "$type": "color", "$value": "#1E6B4F" }
      },
      "chalk": {
        "50": { "$type": "color", "$value": "#F7F5EC" }
      },
      "clay": {
        "500": { "$type": "color", "$value": "#C4552F" },
        "600": { "$type": "color", "$value": "#B24A28" }
      },
      "gold": {
        "400": { "$type": "color", "$value": "#D9A441" }
      },
      "ink": {
        "900": { "$type": "color", "$value": "#0C1322" },
        "800": { "$type": "color", "$value": "#141518" },
        "700": { "$type": "color", "$value": "#10201A" }
      }
    }
  },
  "theme": {
    "volt-precision": {
      "color": {
        "bg": { "$type": "color", "$value": "{global.color.court.950}" },
        "surface": { "$type": "color", "$value": "#0E2038" },
        "surface-raised": { "$type": "color", "$value": "{global.color.court.700}" },
        "text": { "$type": "color", "$value": "{global.color.line.50}" },
        "text-muted": { "$type": "color", "$value": "#C7D2E4" },
        "accent": { "$type": "color", "$value": "{global.color.volt.400}" },
        "accent-contrast": { "$type": "color", "$value": "{global.color.court.950}" },
        "link": { "$type": "color", "$value": "{global.color.court.500}" },
        "border": { "$type": "color", "$value": "#1D3252" }
      },
      "font": {
        "display": { "$type": "fontFamily", "$value": ["Anybody", "sans-serif"] },
        "body": { "$type": "fontFamily", "$value": ["Archivo", "sans-serif"] },
        "data": { "$type": "fontFamily", "$value": ["IBM Plex Mono", "monospace"] }
      }
    },
    "carbon-drive": {
      "color": {
        "bg": { "$type": "color", "$value": "{global.color.alloy.100}" },
        "surface": { "$type": "color", "$value": "#F4F3F0" },
        "surface-inverse": { "$type": "color", "$value": "{global.color.carbon.900}" },
        "text": { "$type": "color", "$value": "{global.color.ink.800}" },
        "text-muted": { "$type": "color", "$value": "#5A5F66" },
        "accent": { "$type": "color", "$value": "{global.color.drive.600}" },
        "accent-contrast": { "$type": "color", "$value": "{global.color.ink.800}" },
        "border": { "$type": "color", "$value": "{global.color.alloy.300}" }
      },
      "font": {
        "display": { "$type": "fontFamily", "$value": ["Chakra Petch", "sans-serif"] },
        "body": { "$type": "fontFamily", "$value": ["IBM Plex Sans", "sans-serif"] },
        "data": { "$type": "fontFamily", "$value": ["IBM Plex Mono", "monospace"] }
      }
    },
    "club-real": {
      "color": {
        "bg": { "$type": "color", "$value": "{global.color.chalk.50}" },
        "surface": { "$type": "color", "$value": "#FFFFFF" },
        "surface-brand": { "$type": "color", "$value": "{global.color.pine.800}" },
        "text": { "$type": "color", "$value": "{global.color.ink.700}" },
        "text-muted": { "$type": "color", "$value": "#3E4A40" },
        "accent": { "$type": "color", "$value": "{global.color.clay.600}" },
        "accent-contrast": { "$type": "color", "$value": "{global.color.chalk.50}" },
        "highlight": { "$type": "color", "$value": "{global.color.gold.400}" },
        "border": { "$type": "color", "$value": "#E2DECE" }
      },
      "font": {
        "display": { "$type": "fontFamily", "$value": ["Bricolage Grotesque", "sans-serif"] },
        "body": { "$type": "fontFamily", "$value": ["Instrument Sans", "sans-serif"] },
        "voice": { "$type": "fontFamily", "$value": ["Instrument Serif", "serif"] }
      }
    }
  }
}
