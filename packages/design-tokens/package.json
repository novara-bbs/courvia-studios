{
  "name": "@courvia/design-tokens",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Canonical DTCG tokens (from brand/courvia-tokens.json) + typed build script emitting CSS variables",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./tokens.json"
  },
  "scripts": {
    "build": "tsx src/build-css.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@courvia/config": "workspace:*"
  }
}
