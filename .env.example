# Copy to .env.local (gitignored) and fill in. Never commit real values.
# Deploy secrets live in Vercel; CI secrets in GitHub Environments.
#
# The agent never requests, reads or uses SUPABASE_SECRET_KEY, Postgres
# passwords or any payment secret (CLAUDE.md §4).

# ---------------------------------------------------------------- Supabase
# Publishable key: safe in the browser by design. These two names are the ones
# the code reads (apps/web/src/server/data-api-exposure.test.ts, the proof that
# the payload schema shows nothing to an anonymous client). No NEXT_PUBLIC_
# prefix: nothing in the browser talks to Supabase — the storefront reaches
# Postgres through Payload on the server.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server/CI only. Legacy name: service_role.
SUPABASE_SECRET_KEY=
# Used by the Supabase MCP config, not by the app.
SUPABASE_PROJECT_REF=
# Local dev: your local Postgres (e.g. postgresql://courvia@127.0.0.1:5433/courvia_dev).
# CI/production: set in GitHub Environments / Vercel. Never the Supabase owner password here.
DATABASE_URL=

# ----------------------------------------------------------------- Payload
PAYLOAD_SECRET=

# ----------------------------------------------------- CMS editorial opcional
# Payload (por defecto) o WordPress headless. El comercio siempre queda en Payload.
COURVIA_EDITORIAL_SOURCE=payload
WORDPRESS_API_URL=
WORDPRESS_API_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=
WORDPRESS_PREVIEW_SECRET=
WORDPRESS_REVALIDATE_SECRET=

# ------------------------------------------------- Almacenamiento de medios
# Cualquier bucket compatible con S3: Supabase Storage, S3, R2, Backblaze,
# MinIO. Sin estas variables los ficheros van a disco local — correcto en
# desarrollo, y RECHAZADO en un despliegue con filesystem efímero (Vercel),
# porque escribir ahí pierde la imagen en el siguiente deploy sin avisar.
# Las tres primeras son obligatorias juntas: media configuración = sin configurar.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Solo si NO es AWS. Supabase: https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_ENDPOINT=
# Los proveedores compatibles la ignoran, pero el SDK la exige. Por defecto "auto".
S3_REGION=

# ------------------------------------------- Payments, namespaced per provider
# Adding a gateway means adding its block; nothing else changes (ADR-13/14).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_TAX_ENABLED=true

# BNPL for the UAE market (S4) — direct API, not through Stripe (ADR-06).
# Each adapter activates with ITS webhook credential and nothing else; the
# names have to be the ones apps/web/src/server/container.ts reads, or the
# gateway stays off and the webhook route answers 404.
TABBY_API_KEY=
TABBY_WEBHOOK_SECRET=
TAMARA_API_TOKEN=
# The Notification Token (JWT HS256) — never the API token above.
TAMARA_NOTIFICATION_TOKEN=

# Only if a market ever demands it (fees or a local entity). The adapter
# activates on the webhook HMAC key alone.
ADYEN_HMAC_KEY=

# ------------------------------------------------------- Email, invoicing
# Resend is the transactional provider (src/email/resend.ts explains why it,
# and why not its packaged Payload adapter). The two go together: an API key
# without a verified sender delivers nothing and looks configured. Absent on
# a deployment, every send FAILS loudly instead of being swallowed.
RESEND_API_KEY=
# "Courvia <hola@dominio>" or a bare address, on a domain verified at Resend.
EMAIL_FROM=
# Certified VeriFactu provider; never a home-grown invoicing engine (ADR-07).
VERIFACTU_PROVIDER_API_KEY=

# ------------------------------------------------------------------- Cron
# Authenticates GET /next/cron (outbox dispatch + abandoned-checkout sweep).
# Vercel Cron sends it as `Authorization: Bearer $CRON_SECRET`; with no value
# the route refuses to run rather than running for anyone.
CRON_SECRET=

# ----------------------------------------------------------------- Analytics
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --------------------------------------------------------------------- Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=es

# Dev/CI only: enables the in-memory payment provider so the full checkout →
# webhook loop runs without credentials. Fail-closed: with NODE_ENV=production
# it ALSO requires PAYMENT_FAKE_UNSAFE_ALLOW=1 (local prod-mode server only),
# and it is always blocked when VERCEL_ENV=production.
PAYMENT_FAKE_SECRET=
PAYMENT_FAKE_UNSAFE_ALLOW=
