{
  "name": "@courvia/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Courvia storefront \u2014 Next.js App Router with server-side theming",
  "scripts": {
    "dev": "next dev",
    "build": "node ../../scripts/deploy-preflight.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "seed:admin": "tsx src/seeds/seed-admin.ts",
    "seed:catalog": "tsx src/seeds/seed-catalog.ts",
    "seed:media": "tsx src/seeds/seed-media.ts",
    "seed:markets": "tsx src/seeds/seed-markets.ts",
    "seed:content": "tsx src/seeds/seed-content.ts",
    "seed:templates": "tsx src/seeds/seed-templates.ts",
    "seed:e2e-operator": "tsx src/seeds/seed-e2e-operator.ts",
    "sweep:checkouts": "tsx src/scripts/expire-checkouts.ts",
    "check:blocks": "tsx src/scripts/check-blocks.ts",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@courvia/appearance": "workspace:*",
    "@courvia/commerce-domain": "workspace:*",
    "@courvia/commerce-payload": "workspace:*",
    "@courvia/design-tokens": "workspace:*",
    "@courvia/payments-adyen": "workspace:*",
    "@courvia/payments-stripe": "workspace:*",
    "@courvia/payments-tabby": "workspace:*",
    "@courvia/payments-tamara": "workspace:*",
    "@courvia/platform": "workspace:*",
    "@courvia/sections": "workspace:*",
    "@courvia/ui": "workspace:*",
    "@next/env": "16.3.1",
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/live-preview-react": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-s3": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "graphql": "16.14.2",
    "next": "16.3.1",
    "next-intl": "4.13.6",
    "payload": "3.88.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@courvia/config": "workspace:*",
    "@playwright/test": "1.62.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "vitest": "4.1.11"
  }
}
