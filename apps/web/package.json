{
  "name": "@courvia/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Courvia storefront — Next.js App Router with server-side theming",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "seed:admin": "tsx src/payload/seed-admin.ts",
    "seed:catalog": "tsx src/payload/seed-catalog.ts",
    "test": "vitest run --passWithNoTests",
    "seed:markets": "tsx src/payload/seed-markets.ts"
  },
  "dependencies": {
    "@courvia/appearance": "workspace:*",
    "@courvia/commerce-domain": "workspace:*",
    "@courvia/commerce-payload": "workspace:*",
    "@courvia/design-tokens": "workspace:*",
    "@courvia/payments-stripe": "workspace:*",
    "@courvia/platform": "workspace:*",
    "@courvia/sections": "workspace:*",
    "@courvia/ui": "workspace:*",
    "@next/env": "16.3.1",
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/live-preview-react": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "graphql": "16.14.2",
    "next": "16.3.1",
    "next-intl": "4.13.6",
    "payload": "3.88.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@courvia/config": "workspace:*",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "vitest": "4.1.11"
  }
}
