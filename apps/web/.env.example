# Copia este archivo a apps/web/.env.local (ignorado por Git) y rellena.
# Secretos reales: NUNCA en el repo — Vercel (despliegue) o GitHub
# Environments (CI). Ver docs/operations.md.

# Postgres local (scripts/dev-db.sh lo levanta en el puerto 5433).
DATABASE_URL=postgres://postgres@127.0.0.1:5433/courvia

# Firma de sesiones/preview de Payload. Cualquier cadena larga en local.
PAYLOAD_SECRET=cambia-esto-en-local

# Proveedor de pago FAKE para desarrollo (bloqueado en producción por el
# gate fail-closed del container). Cualquier cadena en local.
PAYMENT_FAKE_SECRET=fake-local

# Solo para levantar el servidor local en modo producción (`next start` con
# NODE_ENV=production). Con VERCEL_ENV=production el fake sigue bloqueado
# aunque esto valga 1.
# PAYMENT_FAKE_UNSAFE_ALLOW=1

# --- Primer usuario admin (una sola vez) -------------------------------------
# `pnpm --filter @courvia/web seed:admin` las lee. Se pasan en la misma línea
# del comando, no se guardan aquí: una contraseña en un fichero que se copia
# de plantilla acaba en el historial de la shell y en un backup.
#   ADMIN_EMAIL=tu@correo ADMIN_PASSWORD=... pnpm --filter @courvia/web seed:admin
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=

# --- Almacenamiento de medios ------------------------------------------------
# En local no hacen falta: sin ellas los ficheros van a disco, que es lo
# correcto en una máquina que conserva su disco. En un despliegue con
# filesystem efímero (Vercel) su AUSENCIA desactiva las subidas a propósito:
# escribir ahí devuelve OK y pierde la imagen en el siguiente deploy.
# Las tres primeras van juntas — media configuración cuenta como ninguna.
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Solo si no es AWS. Supabase: https://<project-ref>.storage.supabase.co/storage/v1/s3
# S3_ENDPOINT=
# Los proveedores compatibles la ignoran, pero el SDK la exige. Por defecto "auto".
# S3_REGION=

# --- Correo saliente ---------------------------------------------------------
# En local no hacen falta: sin ellas Payload usa su adaptador de consola y el
# correo se registra en el log en vez de enviarse, que es lo correcto en una
# máquina donde nadie espera recibirlo. En un despliegue su AUSENCIA hace que
# cada envío FALLE en voz alta (la fila del outbox queda en rojo) en vez de
# tragarse el mensaje. Las dos van juntas: media configuración cuenta como
# ninguna. Ver src/email/adapter.ts.
# RESEND_API_KEY=
# Remitente verificado en el proveedor: "Courvia <hola@dominio>" o la dirección sola.
# EMAIL_FROM=

# Dirección de OPERACIONES: quien atiende un pago que se contradice.
# Con ella, los efectos `alert_payment_conflict` y `alert_refund_failure` se
# mandan por correo; sin ella, esas filas se quedan PENDIENTES en el outbox y
# el censo del cron las nombra en cada tick. Es a propósito: registrar el
# handler sin dirección quemaría los cinco intentos y dejaría la fila en
# `failed`, que se ve menos que pendiente. Ver src/server/outbox-handlers.ts.
# OPS_EMAIL=

# --- Cron de mantenimiento ---------------------------------------------------
# Autentica GET /next/cron (despacho del outbox + caducidad de checkouts).
# Vercel Cron lo envía como `Authorization: Bearer $CRON_SECRET`. Sin esta
# variable la ruta se niega a ejecutar: una URL pública que vacía el outbox es
# una URL para hacernos enviar correo. En local, cualquier cadena.
# CRON_SECRET=

# --- Opcionales -------------------------------------------------------------

# Origen público (canonicals, sitemap, JSON-LD). En Vercel llega solo.
# NEXT_PUBLIC_SITE_URL=https://courvia.com

# Stripe: registra el adaptador real (whsec_... del dashboard de webhooks).
# STRIPE_WEBHOOK_SECRET=

# Adyen: clave HMAC (hex) del webhook estándar en el Customer Area.
# ADYEN_HMAC_KEY=

# Tabby: el valor exacto del header registrado con el endpoint del webhook.
# TABBY_WEBHOOK_SECRET=

# Tamara: el Notification Token (JWT HS256) — nunca el API token.
# TAMARA_NOTIFICATION_TOKEN=

# Analítica sin cookies (Plausible): activa el script con el dominio.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=courvia.com

# Test de exposición del Data API (apps/web/src/server/data-api-exposure.test.ts):
# la clave PUBLICABLE es pública por diseño; el test demuestra que no ve nada.
# SUPABASE_URL=https://xurdwzbefgxpfzgkbbkf.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
