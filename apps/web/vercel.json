{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=@courvia/web",
  "crons": [
    {
      "path": "/next/cron",
      "schedule": "0 4 * * *"
    }
  ]
}
